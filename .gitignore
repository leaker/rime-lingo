# macOS
.DS_Store

# Xcode / SwiftPM
build/
DerivedData/
.build/
.swiftpm/
*.xcodeproj/
!*.xcodeproj/project.xcworkspace/
xcuserdata/
*.xcuserstate

# Vendored binaries — fetched by scripts/fetch-*.sh, pinned by *.lock
Vendor/*
!Vendor/*.lock
!Vendor/README.md

# Local artifacts
.ui-acceptance/
.env
.env.*
!.env.example
.signing/
*.log
__pycache__/
*.pyc
dist/

# Signing and notarization material must never be committed
*.p8
*.p12
*.pem
*.key
*.cer
*.mobileprovision
*.keychain-db

# SwiftPM binary target assembled by scripts/fetch-librime.sh
Packages/RimeLingoKit/Frameworks/

# Kept on this machine only, not versioned: project notes and community
# and release documents. scripts/embed-license-materials.py still reads
# THIRD_PARTY_NOTICES.md at build time, so it must stay on disk.
/docs/
/SECURITY.md
/CODE_OF_CONDUCT.md
/CONTRIBUTING.md
/CONTRIBUTING.zh.md
/THIRD_PARTY_NOTICES.md
/CHANGELOG.md
/CHANGELOG.en.md
# Brand artwork and CI configuration: kept locally only.
/assets/
/.github/
